# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build and output
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (committed base .env with local emulation defaults; ignore local overrides and secret profiles)
.env*.local
.env.production
.env.staging
!.env
!.env.example
!.env.production.example

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# AI & Agent artifacts
.agents/
.claude/
.windsurf/
.junie/
.playwright-mcp/

# local database storage
.pg_data/

# logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# test artifacts & screenshots
/coverage/
/playwright-report/
/test-results/
*.png
!public/**/*.png
!icon.png
!src/**/*.png
capture.js
get_diff.js
diff_seed.txt
test-helper.js
test-*.js
test-*.ts.bak
test-loop.ts
test-tree-loop.ts
test-truth.ts