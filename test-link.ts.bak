import { prisma } from './src/lib/prisma';
import { linkPhoneToUserAction } from './src/app/actions/auth';
import * as admin from './src/lib/firebase/admin';

async function main() {
  const user1 = await prisma.user.create({
    data: { email: 'test1@example.com', firebaseUid: 'uid1', phone: '+1234567890' }
  });
  const user2 = await prisma.user.create({
    data: { email: 'test2@example.com' }
  });

  // mock getLoggedInUserId
  const session = require('./src/lib/session');
  session.getLoggedInUserId = async () => user2.id;
  
  // mock verifyIdToken
  admin.verifyIdToken = async () => ({ uid: 'uid1', phone_number: '+1234567890' } as any);
  
  try {
    await linkPhoneToUserAction('fake-token');
    console.log("Success");
  } catch(e) {
    console.error("Caught error:", e);
  }

  await prisma.user.deleteMany({ where: { id: { in: [user1.id, user2.id] } } });
}

main();
