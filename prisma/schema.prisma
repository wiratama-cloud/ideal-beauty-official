generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  SALE
  RENTAL
}

enum OrderStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  NOT_APPLICABLE
  OUT_WITH_CUSTOMER
  RETURNED
  LATE
  DAMAGED
}

enum PaymentType {
  DOWN_PAYMENT
  FINAL_BALANCE
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DebitCredit {
  DEBIT
  CREDIT
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum VoucherTargetType {
  EVENT
  CUSTOMER
}

enum EntryType {
  INCOME
  EXPENSE
  DEBIT
  CREDIT
}

enum ExpenseCategory {
  DESIGN_RND
  MANUFACTURING_COGS
  OPERATIONAL
  MARKETING
}

enum IncomeCategory {
  SALES_REVENUE
  RENTAL_REVENUE
  LATE_FEES
  OTHER
}

enum SectionType {
  NEW_ARRIVALS
  FEATURED_BRANDS
  EDITORS_PICKS
  CUSTOM_GRID
  PROMO_BANNER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  phone         String?
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  vouchers      Voucher[]
  voucherUsages VoucherUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  recipientName String
  phone         String
  addressLine1  String
  city          String
  province      String
  postalCode    String
  isDefault     Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  description   String?
  category      String?              @default("Ready To Wear")
  images        String[]             @default([])
  isActive      Boolean              @default(true)
  variants      ProductVariant[]
  ledgerEntries LedgerEntry[]
  wishlistedBy  WishlistItem[]
  sectionItems  LandingSectionItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, slug])
}

model ProductVariant {
  id                 String          @id @default(uuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String          @unique
  attributes         Json
  priceSale          Decimal?        @db.Decimal(10, 2)
  priceRent          Decimal?        @db.Decimal(10, 2)
  compareAtPrice     Decimal?               @db.Decimal(10, 2)
  costPrice          Decimal?               @db.Decimal(10, 2)
  purchaseCost       Decimal?               @db.Decimal(10, 2)

  // Separated Stock Pools
  stockSaleTotal     Int                    @default(0)
  stockSaleAvailable Int                    @default(0)
  stockRentTotal     Int                    @default(0)
  stockRentAvailable Int                    @default(0)

  // Deprecated legacy fallback fields
  stockTotal         Int                    @default(0)
  stockAvailable     Int                    @default(0)

  orderItems            OrderItem[]
  cartItems             CartItem[]
  wishlistedBy          WishlistItem[]
  ledgerEntries         LedgerEntry[]
  rentalBlocks          RentalBlock[]
  inventoryTransactions InventoryTransaction[]

  @@index([productId, sku])
  @@index([productId, stockAvailable])
  @@index([productId, stockSaleAvailable])
  @@index([productId, stockRentAvailable])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sessionId])
  @@index([userId])
}

model CartItem {
  id            String         @id @default(uuid())
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type          ItemType
  quantity      Int            @default(1)
  rentStartDate DateTime?
  rentEndDate   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cartId, variantId, type])
  @@index([cartId, variantId])
}

model WishlistItem {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@unique([userId, productId])
}

model Order {
  id                String         @id @default(uuid())
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  totalAmount       Decimal        @db.Decimal(10, 2)
  discountAmount    Decimal?       @default(0) @db.Decimal(10, 2)
  status            OrderStatus    @default(PENDING)
  shippingAddressId String?
  shippingAddress   Address?       @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingCost      Decimal?       @db.Decimal(10, 2)
  courierName       String?
  trackingNumber    String?
  voucherId         String?
  voucher           Voucher?       @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  voucherUsages     VoucherUsage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId, status])
  @@index([voucherId])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  type          ItemType
  quantity      Int            @default(1)
  priceAtTime   Decimal        @db.Decimal(10, 2)
  rentStartDate DateTime?
  rentEndDate   DateTime?
  rentalStatus  RentalStatus   @default(NOT_APPLICABLE)
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal         @db.Decimal(10, 2)
  type          PaymentType
  status        PaymentStatus   @default(PENDING)
  paymentMethod String?         @default("QRIS")
  providerTxId  String?
  qrisUrl       String?
  vaNumber      String?
  bankName      String?
  ledgerEntries LedgerEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId, status])
}

model LedgerEntry {
  id              String           @id @default(uuid())
  sequence        Int              @default(autoincrement())
  type            EntryType
  dcType          DebitCredit?
  tranCode        String?
  tranSequence    Int?
  amount          Decimal          @db.Decimal(10, 2)
  description     String
  incomeCategory  IncomeCategory?
  expenseCategory ExpenseCategory?
  paymentId       String?
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdAt, type])
  @@index([sequence])
}

model LandingSection {
  id           String               @id @default(uuid())
  title        String
  subtitle     String?
  type         SectionType          @default(CUSTOM_GRID)
  viewAllUrl   String?
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  tabs         String[]             @default([])
  items        LandingSectionItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isActive, displayOrder])
}

model LandingSectionItem {
  id           String         @id @default(uuid())
  sectionId    String
  section      LandingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title        String?
  subtitle     String?
  imageUrl     String?
  linkUrl      String?
  categoryTab  String?
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([sectionId, displayOrder])
}

model RentalBlock {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String         @default("MAINTENANCE") // MAINTENANCE, DRY_CLEANING, DAMAGED, BLACKOUT
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([variantId, startDate, endDate])
}

enum InventoryTransactionType {
  ADD
  REMOVE
  ADJUSTMENT
  SALE
  RENTAL
  RETURN
}

model InventoryTransaction {
  id           String                   @id @default(uuid())
  variantId    String
  variant      ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type         InventoryTransactionType @default(ADD)
  quantity     Int
  reason       String?                  // Reason for stock addition/removal e.g. "PURCHASE", "DAMAGE", "RESTOCK", "AUDIT_ADJUSTMENT"
  cost         Decimal?                 @db.Decimal(10, 2) // Unit cost or purchase cost
  purchaseCost Decimal?                 @db.Decimal(10, 2) // Purchase cost
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([variantId, createdAt])
}

model Voucher {
  id            String              @id @default(uuid())
  code          String              @unique
  description   String?
  discountType  VoucherDiscountType
  discountValue Decimal             @db.Decimal(10, 2)
  minPurchase   Decimal?            @db.Decimal(10, 2)
  maxDiscount   Decimal?            @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usageCount    Int                 @default(0)
  isActive      Boolean             @default(true)
  targetType    VoucherTargetType   @default(EVENT)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  usages        VoucherUsage[]
  orders        Order[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([code])
  @@index([userId])
}

model VoucherUsage {
  id             String   @id @default(uuid())
  voucherId      String
  voucher        Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  @@index([voucherId])
  @@index([orderId])
  @@index([userId])
}
