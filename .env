# ==========================================
# Ideal Beauty Official - Local Environment Configuration
# ==========================================
# Pre-configured for 100% offline local development and zero-dependency emulation.
# No external cloud accounts (Firebase/Midtrans) or cloud databases required.

# ------------------------------------------
# Database Configuration (Local PostgreSQL)
# ------------------------------------------
# Connects to containerized PostgreSQL started via `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idealbeauty?schema=public"
DATABASE_POOL_MAX="10"

# ------------------------------------------
# Application Base URL & Admin Access
# ------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_EMAIL="dafa.wiratama@wiratama.cloud"

# ------------------------------------------
# Payment Gateway Configuration (Midtrans Sandbox / Local Mock)
# ------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-sample-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-sample-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-sample-key"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MOCK_MODE="true"

# ------------------------------------------
# Firebase Emulators (Storage & Auth)
# ------------------------------------------
# Connects Firebase Admin & Client SDKs to local Firebase emulators (started via `firebase emulators:start`)
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# ------------------------------------------
# Firebase Server SDK (Production only, leave commented for local emulator)
# ------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# ------------------------------------------
# Firebase Configuration
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ideal-beauty-official-b313d"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ideal-beauty-official-b313d.appspot.com"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyMockLocalApiKeyForOfflineDev12345"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="localhost"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
