# ==========================================
# Ideal Beauty Official - Production Environment Configuration Template
# ==========================================
# This template outlines all environment variables required for production deployment on Firebase App Hosting.
# In production, sensitive variables must be stored in GCP Secret Manager and referenced in `apphosting.yaml`.

# ------------------------------------------
# Database Configuration (PostgreSQL / Prisma ORM)
# ------------------------------------------
# Production PostgreSQL connection string.
# For serverless runtime environments (Firebase App Hosting / Cloud Run), connection pooling is strongly recommended.
# Examples:
# Direct PG / Cloud SQL (with connection limit): postgresql://user:password@host:5432/dbname?schema=public&sslmode=require&connection_limit=5
# PgBouncer / Neon / Supabase Pooler: postgresql://user:password@pgpool-host:6543/dbname?schema=public&pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://neondb_owner:npg_JpVKGZY3aqX7@ep-delicate-river-axjxlgkp.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# Firebase Admin SDK Configuration (Server-side)
# ------------------------------------------
# Single-line minified JSON string of the Firebase Service Account Key for administrative tasks (Storage, FCM, etc.).
# Obtain from Firebase Console > Project Settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ------------------------------------------
# Payment Gateway Configuration (Midtrans)
# ------------------------------------------
# Midtrans Production Server Key (used for transaction processing and webhook signature validation).
MIDTRANS_SERVER_KEY="Mid-server-YOUR_PRODUCTION_SERVER_KEY"

# ------------------------------------------
# Firebase Client SDK Configuration (Public Client-side)
# ------------------------------------------
# Public client configuration for Firebase SDK frontend initialization and FCM push notifications.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourProductionApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="BEl7...YourProductionVapidKey"
