# ==========================================
# Ideal Beauty Official - Local Environment Configuration
# ==========================================
# Configured for 100% offline local development without external cloud dependencies.

# ------------------------------------------
# Database Configuration (Local PostgreSQL)
# ------------------------------------------
# Connects to containerized PostgreSQL started via `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idealbeauty?schema=public"
DATABASE_POOL_MAX="5"

# ------------------------------------------
# Application Base URL & Admin Access
# ------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_EMAIL="admin@idealbeautyofficial.com"

# ------------------------------------------
# Payment Gateway Configuration (Local Mock / Sandbox)
# ------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-sample-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-sample-key"

# ------------------------------------------
# Firebase Server SDK (Disabled for Local Storage)
# ------------------------------------------
# Leave commented out to use local disk storage (`public/uploads`) instead of Firebase Cloud Storage:
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# ------------------------------------------
# Firebase Client SDK Configuration (Mock / Local Offline)
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyMockLocalApiKeyForOfflineDev12345"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="localhost"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="idealbeauty-local"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
